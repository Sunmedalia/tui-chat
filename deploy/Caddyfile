{$CHAT_DOMAIN} {
	@chat_ws path /v2/ws
	reverse_proxy @chat_ws server:8080 {
		health_uri /healthz
		health_interval 30s
	}

	respond 404

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}
